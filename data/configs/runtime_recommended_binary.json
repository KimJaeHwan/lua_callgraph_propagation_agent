{
  "pipeline_name": "runtime_recommended_binary",
  "description": "Recommended default config for binary input. Only change the target binary and target metadata.",
  "paths": {
    "session_name": "recommended_binary_run",
    "target_binary": "data/runtime/input/example_target.so",
    "target_lua_version": "Lua_547",
    "target_architecture": "x86_64",
    "target_opt_level": "O0",
    "target_strip_mode": "nostrip"
  },
  "steps": {
    "extract_query_features": {
      "enabled": true
    },
    "bulk_retrieval": {
      "enabled": true,
      "candidate_pool": 100,
      "topk": 20,
      "scoring_mode": "bonus_v2",
      "mode": "runtime_query"
    },
    "select_seed_anchors": {
      "enabled": true,
      "min_top1_score": 0.92,
      "min_margin": 0.05
    },
    "build_runtime_suite": {
      "enabled": true
    },
    "build_reference_db": {
      "enabled": false,
      "replace": false
    },
    "propagation": {
      "enabled": true
    },
    "deferred_analysis": {
      "enabled": true,
      "top_candidates": 5
    },
    "final_report": {
      "enabled": true
    }
  },
  "external_steps": []
}
