{
  "pipeline_name": "runtime_recommended_binary",
  "description": "Recommended binary-input config. Edit user_input first; most runtime paths are derived automatically.",
  "session_name": "recommended_binary_run",
  "user_input": {
    "binary": "data/runtime/input/lua547_x86_64_O0_vanilla_demo",
    "lua_version": "Lua_547",
    "architecture": "x86_64",
    "opt_level": "O0",
    "strip_mode": "nostrip"
  },
  "runtime": {
    "results_root": "data/runtime/results",
    "query_features_root": "data/runtime/query_features",
    "extractor_work_root": "data/runtime/extractor_workspace"
  },
  "analysis": {
    "retrieval": {
      "candidate_pool": 100,
      "topk": 20,
      "scoring_mode": "bonus_v2"
    },
    "seed_anchors": {
      "min_top1_score": 0.92,
      "min_margin": 0.05
    },
    "propagation": {
      "iterative": true
    },
    "deferred_analysis": {
      "top_candidates": 5
    }
  },
  "graph_config": {
    "max_rounds": 20,
    "convergence_patience": 3,
    "min_delta_accepted": 5,
    "suspicious_threshold": 5,
    "auto_blacklist_threshold": 10,
    "seed_min_top1_score": 0.92,
    "seed_min_margin": 0.05,
    "seed_dedup_max_per_ref": 1,
    "targeted_min_score": 0.74,
    "targeted_min_margin": 0.15,
    "trusted_min_score": 0.9,
    "decompile_min_score": 0.8,
    "deferred_min_score_relaxation": 0.05,
    "deferred_no_graph_min_score": 0.88,
    "max_ida_cases_per_round": 10,
    "fresh_retrieval_anchor_delta": 20,
    "allow_auto_rename": true,
    "allow_fresh_retrieval": true,
    "prefer_deferred_over_guess": true,
    "max_tool_failures": 3,
    "rename_min_score": 0.92,
    "rename_relaxed_min_score": 0.89,
    "enable_ida_type_injection": true,
    "ida_type_injection_mode": "vanilla_headers",
    "safe_auto_rename_prefixes": [
      "luaD_",
      "luaZ_",
      "luaV_finish",
      "luaopen_"
    ]
  },
  "managed_paths": {
    "note": "Usually leave these alone. resolve_paths() derives retrieval_index, reference_db, extract_manifest_json, final_report_json, and manual_force_anchors_json from session_name + user_input.",
    "derived_examples": {
      "retrieval_index": "data/inputs/retrieval_indexes/<lua_version>/<architecture>/runtime",
      "reference_db": "data/inputs/callgraphs/<lua_version>/reference_callgraph.sqlite",
      "extract_manifest_json": "data/runtime/query_features/<feature_namespace>/extract_manifest.json",
      "result_root": "data/runtime/results/<session_name>",
      "manual_force_anchors_json": "data/runtime/results/<session_name>/manual_force_anchors.json"
    }
  }
}
